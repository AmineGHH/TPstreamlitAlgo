def inorder(self, root):
        """Retourne les éléments triés en ordre croissant."""
        if root is None:
            return []
        return self.inorder(root.left) + [root.key] + self.inorder(root.right)

    # ----------------------------
    #  COMPLEXITÉ DU TRI INORDER
    # ----------------------------

    """
    Complexité du tri (parcours InOrder) :

    Temps : O(n)
        - On visite chaque nœud exactement une fois.

    Espace : O(h)
        - h = hauteur du Treap
        - O(log n) en moyenne (grâce aux priorités)
        - O(n) dans le pire cas (arbre dégénéré)
    """
